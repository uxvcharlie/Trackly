<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" styleClass="fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.trackly.controller.LoginController">
    <VBox alignment="CENTER_LEFT" maxWidth="380" spacing="10" styleClass="tarjeta">
        <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>
        <Label styleClass="marca" text="Trackly"/>
        <Label fx:id="lblTitulo" styleClass="titulo" text="Iniciar sesión"/>

        <VBox fx:id="cajaRegistro" spacing="10">
            <TextField fx:id="txtNombre" promptText="Nombre"/>
            <TextField fx:id="txtPresupuesto" promptText="Presupuesto del mes (opcional)"/>
        </VBox>

        <TextField fx:id="txtCorreo" promptText="Correo"/>
        <PasswordField fx:id="txtClave" onAction="#accion" promptText="Clave"/>

        <Label fx:id="lblMensaje" styleClass="mensaje" wrapText="true"/>
        <Button fx:id="btnAccion" defaultButton="true" maxWidth="Infinity" onAction="#accion" text="Entrar"/>
        <Hyperlink fx:id="lnkCambiar" onAction="#cambiarModo" text="No tengo cuenta, crear una"/>
    </VBox>
</VBox>
