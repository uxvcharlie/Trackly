	<summary height="420" splitType="Stretch">
		<element kind="frame" removeLineWhenBlank="true" uuid="45726615-16e1-42e5-905d-8f52b632a51e" x="305" y="8" width="250" height="52">
			<printWhenExpression><![CDATA[$F{categoria} != null]]></printWhenExpression>
			<element kind="line" uuid="43320652-f370-43b5-b4fa-de92e6b41d5c" x="0" y="0" width="250" height="1" forecolor="#1F1D1C"/>
			<element kind="staticText" uuid="9b27edd4-c4b4-44cf-878e-efefa85b35fb" x="0" y="5" width="140" height="14" forecolor="#1F1D1C" fontSize="9.0">
				<text><![CDATA[Total de gastos]]></text>
			</element>
			<element kind="textField" uuid="a1a849f0-c0a5-4040-9b80-a7c770aad571" x="140" y="5" width="110" height="14" forecolor="#1F1D1C" fontSize="9.0" hTextAlign="Right">
				<expression><![CDATA["- C$ " + new java.text.DecimalFormat("#,##0.00").format($V{totalGastos})]]></expression>
			</element>
			<element kind="staticText" uuid="f5962a00-a31b-4f30-9562-6389cc371cfc" x="0" y="19" width="140" height="14" forecolor="#1F1D1C" fontSize="9.0">
				<text><![CDATA[Total de ingresos]]></text>
			</element>
			<element kind="textField" uuid="5b4d4742-287d-4a00-aa24-3ac63eb80474" x="140" y="19" width="110" height="14" forecolor="#4F6B3A" fontSize="9.0" hTextAlign="Right">
				<expression><![CDATA["+ C$ " + new java.text.DecimalFormat("#,##0.00").format($V{totalIngresos})]]></expression>
			</element>
			<element kind="staticText" uuid="a51a6805-9025-4cac-b969-5ed1e885d1be" x="0" y="34" width="140" height="16" forecolor="#8A3D3D" fontSize="10.0" bold="true">
				<text><![CDATA[Balance del mes]]></text>
			</element>
			<element kind="textField" uuid="e584fd2b-c814-4919-a8be-c62e7cfdae99" x="140" y="34" width="110" height="16" forecolor="#8A3D3D" fontSize="10.0" bold="true" hTextAlign="Right">
				<expression><![CDATA["C$ " + new java.text.DecimalFormat("#,##0.00;- #,##0.00").format($V{totalIngresos}.subtract($V{totalGastos}))]]></expression>
			</element>
		</element>
		<element kind="staticText" uuid="01c0c579-686d-4815-9088-c9f37bbecaab" removeLineWhenBlank="true" x="0" y="74" width="270" height="16" forecolor="#1F1D1C" fontSize="11.0" bold="true">
			<printWhenExpression><![CDATA[$V{totalGastos}.signum() > 0]]></printWhenExpression>
