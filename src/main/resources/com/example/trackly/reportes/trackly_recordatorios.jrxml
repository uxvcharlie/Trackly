<!-- Trackly: subreporte de recordatorios y pagos del mes (va dentro de trackly_reporte_mensual) -->
<jasperReport name="trackly_recordatorios" language="java" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="AllSectionsNoDetail" uuid="eca5a274-3382-44ea-be73-a733d75ec097">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Trackly"/>
	<parameter name="ID_USUARIO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="DESDE" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1))]]></defaultValueExpression>
	</parameter>
	<parameter name="HASTA" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.YearMonth.now().atEndOfMonth())]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT r.titulo,
	r.fecha_hora,
	r.monto,
	c.nombre AS categoria,
	r.hecho,
	r.mensual
FROM recordatorios r
	LEFT JOIN categorias c ON c.id = r.id_categoria
WHERE r.id_usuario = $P{ID_USUARIO}
	AND (CAST(r.fecha_hora AS DATE) BETWEEN $P{DESDE} AND $P{HASTA}
		OR (r.hecho = FALSE AND CAST(r.fecha_hora AS DATE) < $P{DESDE}))
ORDER BY r.fecha_hora]]></query>
	<field name="titulo" class="java.lang.String"/>
	<field name="fecha_hora" class="java.sql.Timestamp"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="hecho" class="java.lang.Boolean"/>
	<field name="mensual" class="java.lang.Boolean"/>
	<variable name="porPagar" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[!$F{hecho} && $F{monto} != null ? $F{monto} : java.math.BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="pagado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{hecho} && $F{monto} != null ? $F{monto} : java.math.BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="atrasados" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[!$F{hecho} && $F{fecha_hora}.before(new java.util.Date()) ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<title height="44" splitType="Stretch">
		<element kind="staticText" uuid="c3908d4e-262e-4ea6-a0c2-d4f3d4c65ffe" x="0" y="0" width="555" height="18" forecolor="#1F1D1C" fontSize="12.0" bold="true">
			<text><![CDATA[Recordatorios y pagos]]></text>
		</element>
		<element kind="staticText" uuid="185715f7-c752-4e7f-bea2-0c70bf9fd282" x="0" y="18" width="555" height="12" forecolor="#6B655C" fontSize="8.0">
			<text><![CDATA[Los del mes y los pendientes que quedaron atrasados de meses anteriores.]]></text>
		</element>
		<element kind="textField" uuid="3f1f6c45-0aea-4f71-831d-de480c4c25a7" x="0" y="30" width="555" height="14" forecolor="#6B655C" fontSize="8.5">
			<printWhenExpression><![CDATA[$F{titulo} == null]]></printWhenExpression>
			<expression><![CDATA["No hay recordatorios en este mes."]]></expression>
		</element>
	</title>
	<columnHeader height="20" splitType="Stretch">
		<printWhenExpression><![CDATA[$F{titulo} != null]]></printWhenExpression>
		<element kind="staticText" uuid="a6635beb-715f-4263-8c55-9b4d06e36470" x="6" y="3" width="80" height="14" forecolor="#6B655C" fontSize="8.0" bold="true">
			<text><![CDATA[FECHA]]></text>
		</element>
		<element kind="staticText" uuid="6a5c5bd0-45c4-437e-9af1-a77563c5f270" x="90" y="3" width="200" height="14" forecolor="#6B655C" fontSize="8.0" bold="true">
			<text><![CDATA[RECORDATORIO]]></text>
		</element>
		<element kind="staticText" uuid="68bfe244-83e4-4962-adad-8604a810c70d" x="294" y="3" width="85" height="14" forecolor="#6B655C" fontSize="8.0" bold="true">
			<text><![CDATA[CATEGORÍA]]></text>
		</element>
		<element kind="staticText" uuid="11f14c36-9a8e-4d9d-a203-62e48b4caafd" x="383" y="3" width="80" height="14" forecolor="#6B655C" fontSize="8.0" bold="true" hTextAlign="Right">
			<text><![CDATA[MONTO]]></text>
		</element>
		<element kind="staticText" uuid="c6109ec2-30c2-48b9-8075-a33a2e5771c2" x="475" y="3" width="80" height="14" forecolor="#6B655C" fontSize="8.0" bold="true">
			<text><![CDATA[ESTADO]]></text>
		</element>
		<element kind="line" uuid="b5aae102-5a93-4aec-882c-483d18a9a73f" x="0" y="18" width="555" height="1" forecolor="#1F1D1C"/>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<element kind="textField" uuid="aae0f962-32c3-4dd9-b38a-f398f8c3146c" x="6" y="2" width="80" height="14" forecolor="#1F1D1C" fontSize="8.5" pattern="dd/MM HH:mm">
				<expression><![CDATA[$F{fecha_hora}]]></expression>
			</element>
			<element kind="textField" uuid="ca580184-3d0a-4803-9aee-cc10ef896759" x="90" y="2" width="200" height="14" forecolor="#1F1D1C" fontSize="8.5" textAdjust="ScaleFont">
				<expression><![CDATA[$F{titulo} + ($F{mensual} ? "  (cada mes)" : "")]]></expression>
			</element>
			<element kind="textField" uuid="fa63cffb-223c-4535-88b8-853f791a4458" x="294" y="2" width="85" height="14" forecolor="#6B655C" fontSize="8.5">
				<expression><![CDATA[$F{categoria} == null ? "—" : $F{categoria}]]></expression>
			</element>
			<element kind="textField" uuid="0fcfea3b-b4c0-48c1-8829-acbbbe4c14b7" x="383" y="2" width="80" height="14" forecolor="#1F1D1C" fontSize="8.5" hTextAlign="Right">
				<expression><![CDATA[$F{monto} == null ? "—" : "C$ " + new java.text.DecimalFormat("#,##0.00").format($F{monto})]]></expression>
			</element>
			<element kind="textField" uuid="9315860f-3967-4489-9906-28c488334fe0" x="475" y="2" width="80" height="14" forecolor="#4F6B3A" fontSize="8.5" bold="true">
				<printWhenExpression><![CDATA[$F{hecho}]]></printWhenExpression>
				<expression><![CDATA[$F{monto} == null ? "Hecho" : "Pagado"]]></expression>
			</element>
			<element kind="textField" uuid="3ef8acac-74c4-432f-a526-22cf85599b18" x="475" y="2" width="80" height="14" forecolor="#A8463D" fontSize="8.5" bold="true">
				<printWhenExpression><![CDATA[!$F{hecho} && $F{fecha_hora}.before(new java.util.Date())]]></printWhenExpression>
				<expression><![CDATA["Atrasado"]]></expression>
			</element>
			<element kind="textField" uuid="67e64f33-6307-43ce-9b6d-b479c9a75fae" x="475" y="2" width="80" height="14" forecolor="#8A6A2E" fontSize="8.5" bold="true">
				<printWhenExpression><![CDATA[!$F{hecho} && !$F{fecha_hora}.before(new java.util.Date())]]></printWhenExpression>
				<expression><![CDATA["Pendiente"]]></expression>
			</element>
			<element kind="line" uuid="9ced4ec5-ac49-4cf2-8655-bffa3dec2fe3" x="0" y="17" width="555" height="1" forecolor="#ECE7DE"/>
		</band>
	</detail>
	<summary height="24" splitType="Stretch">
		<printWhenExpression><![CDATA[$F{titulo} != null]]></printWhenExpression>
		<element kind="textField" uuid="e842916d-1df8-4d4c-9588-f4988f93744e" x="0" y="6" width="555" height="14" forecolor="#1F1D1C" fontSize="9.0" hTextAlign="Right">
			<expression><![CDATA["Pagado: C$ " + new java.text.DecimalFormat("#,##0.00").format($V{pagado})
	+ "   ·   Por pagar: C$ " + new java.text.DecimalFormat("#,##0.00").format($V{porPagar})
	+ ($V{atrasados} > 0 ? "   ·   " + $V{atrasados} + ($V{atrasados} == 1 ? " atrasado" : " atrasados") : "")]]></expression>
		</element>
	</summary>
</jasperReport>
